{
  "name": "airshock",
  "version": "1.0.0",
  "description": "A game by Matthew Stuart Derbyshire",
  "devDependencies": {
    "@babel/register": "^7.21.0",
    "dotenv-webpack": "^8.0.1",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4",
    "webpack": "^5.84.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.0"
  },
  "scripts": {
    "serve:dev": "npx webpack serve --env development --mode=development",
    "make:hud": "cd ./assets/HUDs && scaff HUD",
    "make:hudComponent": "cd ./assets/HUDs/components && scaff HUDComponent",
    "make:level": "cd ./assets/levels && scaff level",
    "make:model": "cd ./assets/models && scaff model",
    "make:hud:base": "cd ./assets/HUDs && scaff baseHUD",
    "make:hudComponent:base": "cd ./assets/HUDs/components && scaff baseHUDComponent",
    "make:level:base": "cd ./assets/levels && scaff baseLevel",
    "make:model:base": "cd ./assets/models && scaff baseModel"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-Derbyshire/AirShock.git"
