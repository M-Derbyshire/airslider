{
  "name": "airslider",
  "version": "1.0.0",
  "description": "A game by Matthew Stuart Derbyshire",
  "devDependencies": {
    "@babel/register": "^7.21.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.4",
    "webpack": "^5.84.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.15.0",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "serve:dev": "npx webpack serve --config webpack/dev.config.js --mode=development",
    "deploy:prod": "npm run destroy:deploy && npm run deploy:assets && npm run build:prod",
    "deploy:itch": "npm run destroy:deploy && npm run deploy:assets && npm run build:itch",
    "deploy:assets": "node scripts/deployAssets.js",
    "destroy:deploy": "node scripts/removeDeployDir.js",
    "build:prod": "npx webpack --config webpack/prod.config.js --mode=production",
    "build:itch": "npx webpack --config webpack/itch.config.js --mode=production",
    "make:hud": "cd ./src/HUDs && scaff HUD",
    "make:hudComponent": "cd ./src/HUDComponents && scaff HUDComponent",
    "make:level": "cd ./src/levels && scaff level",
    "make:model": "cd ./src/models && scaff model",
    "make:hud:base": "cd ./src/HUDs && scaff baseHUD",
    "make:hudComponent:base": "cd ./src/HUDComponents && scaff baseHUDComponent",
    "make:level:base": "cd ./src/levels && scaff baseLevel",
    "make:model:base": "cd ./src/models && scaff baseModel",
    "test:kernel": "jest ./Kernel"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M-Derbyshire/airslider.git"
  },
  "author": "Matthew Stuart Derbyshire",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/M-Derbyshire/airslider/issues"
  },
  "homepage": "https://github.com/M-Derbyshire/airslider#readme",
  "type": "module"
}
